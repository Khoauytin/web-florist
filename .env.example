# Copy to .env and fill in real values. Never commit .env.

# Postgres. Local: docker compose (port 5433). Supabase: pooler URL for DATABASE_URL, direct URL for DIRECT_URL.
DATABASE_URL="postgresql://florist:florist@localhost:5433/florist_v2"
DIRECT_URL="postgresql://florist:florist@localhost:5433/florist_v2"
TEST_DATABASE_URL="postgresql://florist:florist@localhost:5433/florist_v2_test"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-random-string-of-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Product images: "local" stores files under ./storage, "supabase" uses Supabase Storage
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STORAGE_BUCKET="product-images"

# First owner account, used only by `npm run db:seed`
SEED_OWNER_USERNAME="chushop"
SEED_OWNER_NAME="Chủ shop"
SEED_OWNER_PASSWORD="replace-me-at-least-8-chars"
